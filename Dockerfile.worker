FROM node:22-alpine AS deps
WORKDIR /app
COPY runner-agent/package.json runner-agent/package-lock.json ./
RUN npm ci --omit=dev
FROM node:22-alpine
RUN apk add --no-cache docker-cli git
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY runner-agent/ ./
EXPOSE 4000
CMD ["node","index.js"]
